<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Empty space at the top -->
    <View
        android:id="@+id/emptySpace"
        android:layout_width="0dp"
        android:layout_height="20sp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Turn indicator -->
    <TextView
        android:id="@+id/turnIndicator"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Player 'X' turn"
        android:textSize="20sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/emptySpace"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <!-- Score counter layout -->
    <LinearLayout
        android:id="@+id/scoreLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/turnIndicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/xScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="X Wins: 0"
            android:textSize="16sp"
            android:layout_marginEnd="32dp" />

        <TextView
            android:id="@+id/oScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="O Wins: 0"
            android:textSize="16sp"
            android:layout_marginEnd="32dp" />

        <TextView
            android:id="@+id/draws"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Draws: 0"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Tic Tac Toe grid -->
    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        android:columnCount="3"
        android:rowCount="3"
        android:alignmentMode="alignMargins"
        android:rowOrderPreserved="false"
        android:useDefaultMargins="true"
        app:layout_constraintTop_toBottomOf="@id/scoreLayout"
        app:layout_constraintBottom_toTopOf="@id/playAgain"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/cell0"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="20sp" />

        <Button
            android:id="@+id/cell1"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="20sp" />

        <Button
            android:id="@+id/cell2"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="20sp" />

        <Button
            android:id="@+id/cell3"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="20sp" />

        <Button
            android:id="@+id/cell4"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="20sp" />

        <Button
            android:id="@+id/cell5"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="20sp" />

        <Button
            android:id="@+id/cell6"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="20sp" />

        <Button
            android:id="@+id/cell7"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="20sp" />

        <Button
            android:id="@+id/cell8"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="20sp" />
    </GridLayout>

    <!-- Play Again button -->
    <Button
        android:id="@+id/playAgain"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Play Again"
        android:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>